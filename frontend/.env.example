# --- Supabase (optional, read-only) ------------------------------------------
# The frontend only needs these when it should read historical samples directly
# from the database that the backend worker writes to (see ../supabase/schema.sql
# and ../backend/.env.example, which owns the write credentials).
#
# Without them the dashboard keeps the newest HISTORY_LIMIT samples in memory,
# so it works with zero configuration.
SUPABASE_URL=

# Prefer the anon key here: the read-only RLS policy in supabase/schema.sql is
# designed for it, and the anon key is the only one safe to ship to a deployment
# that also serves browsers.
SUPABASE_ANON_KEY=

# Only use the service role key if this deployment is a fully trusted
# server-to-server environment. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override - must match the backend worker's table.
SUPABASE_PULSE_TABLE=pulse_samples

# --- Multi-Sender module (optional) ------------------------------------------
# Deployed address of contracts/src/PulseMultiSender.sol, per network. The
# contract is deployed separately to each chain and an address is only valid on
# the chain it was deployed to, so both are set independently. Without one, that
# network's page still parses and validates lists but refuses to send and says
# why. The legacy single-address variable below is still read as the mainnet
# value.
#
#   cd contracts && forge script script/DeployPulseMultiSender.s.sol \
#     --rpc-url electroneum --broadcast
#   cd contracts && forge script script/DeployPulseMultiSender.s.sol \
#     --rpc-url electroneum-testnet --broadcast
NEXT_PUBLIC_MULTISENDER_MAINNET=
NEXT_PUBLIC_MULTISENDER_TESTNET=

# Deprecated alias for NEXT_PUBLIC_MULTISENDER_MAINNET, kept so deployments made
# before testnet support keep working.
# NEXT_PUBLIC_MULTISENDER_ADDRESS=

# Optional: overrides the testnet RPC the batch sender reads balances from.
# Defaults to https://rpc-testnet.electroneum.com
# NEXT_PUBLIC_ETN_TESTNET_RPC=
