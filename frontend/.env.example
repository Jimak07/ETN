# --- Supabase (optional, backed by schema.sql) -------------------------------
# The frontend uses these to read historical telemetry and persist user loyalty
# points (VersePoints), on-chain activity ledger, and cloud watchlists.
# See ../supabase/schema.sql.
#
# Without them the dashboard keeps records in memory with zero configuration.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Prefer the anon key for client-facing reads:
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key for verified on-chain backend writes (bypasses RLS):
SUPABASE_SERVICE_ROLE_KEY=

# Optional admin key to protect /api/analytics?export=airdrop snapshot generation:
AIRDROP_ADMIN_KEY=

# Optional override - must match the backend worker's table.
SUPABASE_PULSE_TABLE=pulse_samples

# --- Multi-Sender module (optional) ------------------------------------------
# Deployed address of contracts/src/PulseMultiSender.sol, per network. The
# contract is deployed separately to each chain and an address is only valid on
# the chain it was deployed to, so both are set independently. Without one, that
# network's page still parses and validates lists but refuses to send and says
# why. The legacy single-address variable below is still read as the mainnet
# value.
#
#   cd contracts && forge script script/DeployPulseMultiSender.s.sol \
#     --rpc-url electroneum --broadcast
#   cd contracts && forge script script/DeployPulseMultiSender.s.sol \
#     --rpc-url electroneum-testnet --broadcast
NEXT_PUBLIC_MULTISENDER_MAINNET=
NEXT_PUBLIC_MULTISENDER_TESTNET=

# Deprecated alias for NEXT_PUBLIC_MULTISENDER_MAINNET, kept so deployments made
# before testnet support keep working.
# NEXT_PUBLIC_MULTISENDER_ADDRESS=

# Optional: overrides the testnet RPC the batch sender reads balances from.
# Defaults to https://rpc-testnet.electroneum.com
# NEXT_PUBLIC_ETN_TESTNET_RPC=

# --- Other networks in the batch sender (optional) ---------------------------
# The network selector lists Electroneum, Ethereum and BNB Smart Chain. Ethereum
# and BNB Smart Chain have no PulseMultiSender deployment by default, so they
# validate and price a list but cannot send. Set these only if you deploy there.
# NEXT_PUBLIC_MULTISENDER_ETHEREUM=
# NEXT_PUBLIC_MULTISENDER_BSC=
#
# RPC endpoints fall back to public hosts, so these are overrides rather than
# requirements. An Etherscan/BscScan key is only needed for the
# transaction-status fallback on those chains: it is appended to the explorer API
# call, and both explorers answer without one at a lower rate limit.
# NEXT_PUBLIC_ETHEREUM_RPC=
# NEXT_PUBLIC_BSC_RPC=
# NEXT_PUBLIC_ETHERSCAN_API_KEY=
# NEXT_PUBLIC_BSCSCAN_API_KEY=
