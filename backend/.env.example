# --- Supabase (required to persist samples) ----------------------------------
# Run supabase/schema.sql from the repository root first.
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: the worker runs headless on a server and must be able to
# insert. Never expose this key to the browser (the frontend only needs the
# anon key, and only when it reads history directly).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_PULSE_TABLE=pulse_samples

# --- Discord alerting (optional) ---------------------------------------------
# When set, the worker posts an embed whenever an RPC changes state: goes
# offline, starts drifting past the threshold, or recovers.
DISCORD_WEBHOOK_URL=

# --- Web service --------------------------------------------------------------
# Koyeb injects PORT at runtime and health-checks it, so leave this unset when
# deploying. It is only here so a local run can move off the 10000 default.
# PORT=10000

# --- Polling (optional overrides) --------------------------------------------
POLL_INTERVAL_MS=5000
# Blocks a node may lag behind the highest observed block before it is flagged.
DRIFT_THRESHOLD=3
# Latency above this (ms) marks a node degraded.
LATENCY_THRESHOLD_MS=500
# Per-request JSON-RPC timeout (ms). Keep it below POLL_INTERVAL_MS.
RPC_REQUEST_TIMEOUT_MS=3000
