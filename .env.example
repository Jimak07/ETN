# --- Supabase (optional) -----------------------------------------------------
# When both values are present the pulse engine persists every sample to
# Supabase (see supabase/schema.sql) and serves real historical data back to the
# dashboard. Without them the engine falls back to an in-memory ring buffer.
SUPABASE_URL=
# Server-side key. Use the service role key for a private table, or the anon key
# if you enabled the read-only RLS policy from supabase/schema.sql.
SUPABASE_SERVICE_ROLE_KEY=
# Alternative to the service role key: the anon key works with the read-only RLS
# policy in supabase/schema.sql, but cannot insert samples.
SUPABASE_ANON_KEY=
# Optional overrides
SUPABASE_PULSE_TABLE=pulse_samples
